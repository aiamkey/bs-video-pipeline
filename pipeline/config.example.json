{
  "_说明": "唯一真源。改这里 → 跑 pipeline/run.py <阶段> <EP>。不要在别处改数字。",
  "project": {
    "name": "男生变帅",
    "ep": "voice-bs",
    "script": "scripts/script-bs.json",
    "composition": "DataFilm"
