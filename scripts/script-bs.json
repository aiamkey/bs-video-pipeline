          "card": {
            "type": "copy",
            "text": "头顶有根线，|往上提",
            "size": 92
          }
        },
        {
          "text": "一个月，你走路的样子就不一样了。",
          "gap": 1.0,
          "card": {
            "type": "image",
            "src": "textures/bs/bs-posture.jpg",
            "text": "一个月，走路都不一样"
          }
        }
      ]
