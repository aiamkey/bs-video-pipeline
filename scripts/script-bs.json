    {
      "ch": 0,
      "label": "序",
      "scene": "hook",
      "lines": [
        {
          "text": "兄弟们，先说句实话。",
          "gap": 0.4,
          "card": {
            "type": "copy",
            "text": "兄弟们，|先说句实话",
            "size": 104,
            "dark": true
          }
        },
        {
          "text": "你长得不丑，你只是没打理。",
          "gap": 0.6,
          "card": {
            "type": "copy",
            "text": "你长得不丑，|你只是没打理",
            "size": 78
          }
        },
        {
          "text": "同一张脸，头发塌着、眉毛乱着、背弓着，和收拾干净，是两个人。",
          "gap": 0.7,
          "card": {
            "type": "image",
            "src": "textures/bs/bs-mirror.jpg",
            "text": "收拾干净，是两个人",
            "sub": "头发、眉毛、背，三个地方就够"
          }
        },
        {
          "text": "今天这五件事，不用动刀，也不用花大钱。",
          "gap": 0.5,
          "card": {
            "type": "list",
            "title": "今天这五件事",
            "items": [
              "不用动刀",
              "不用花大钱",
              "看完就能做"
            ]
          }
        },
        {
          "text": "看完就能做，照做一个月，就有人夸你变精神了。",
          "gap": 1.1,
          "card": {
            "type": "copy",
            "text": "照做|一个月|，就有人夸你变精神",
            "size": 72
          }
        }
      ]
    },
    {
      "ch": 1,
      "label": "头发",
      "scene": "hair",
      "lines": [
        {
          "text": "第一件，头发。",
          "gap": 0.45,
          "card": {
            "type": "section",
            "no": "01",
            "title": "头发",
            "sub": "HAIR"
          }
        },
        {
          "text": "发型是男生性价比最高的整容，没有之一。",
          "gap": 0.6,
          "card": {
            "type": "copy",
            "text": "性价比最高的|整容",
            "size": 96
          }
        },
        {
          "text": "记住三条：两侧不要留长，头顶要有蓬松，刘海别盖住眉毛。",
          "gap": 0.6,
          "card": {
            "type": "list",
            "title": "记住三条",
            "items": [
              "两侧不留长",
              "头顶要蓬松",
              "刘海别压眉"
            ]
          }
        },
        {
          "text": "两侧长了，脸显宽；头顶塌了，头显小；",
          "gap": 0.3,
          "card": {
            "type": "no-list",
            "title": "反过来就是",
            "items": [
              "两侧长 → 脸显宽",
              "头顶塌 → 头显小"
            ]
          }
        },
        {
          "text": "刘海压住眉毛，人就显得呆。",
          "gap": 0.6,
          "card": {
            "type": "copy",
            "text": "压眉毛 ＝|显得呆",
            "size": 100,
            "dark": true
          }
        },
        {
          "text": "去剪头别再说随便修一下。",
          "gap": 0.4,
          "card": {
            "type": "copy",
            "text": "别再说|「随便修一下」",
            "size": 88
          }
        },
        {
          "text": "就说：两侧推短，头顶留三指，后面上短下长。",
          "gap": 0.6,
          "card": {
            "type": "cmd",
            "title": "跟理发师说",
            "items": [
              "两侧推短",
              "头顶留三指",
              "后面上短下长"
            ]
          }
        },
        {
          "text": "三个月剪四次，比你买十件衣服都管用。",
          "gap": 1.0,
          "card": {
            "type": "stat",
            "value": "3",
            "unit": "个月 4 次",
            "label": "比买十件衣服都管用"
          }
        }
      ]
    },
    {
      "ch": 2,
      "label": "眉毛",
      "scene": "brow",
      "lines": [
        {
          "text": "第二件，眉毛。",
