          "card": {
            "type": "copy",
            "text": "三处修掉，|立刻利落",
            "size": 96
          }
        },
        {
          "text": "别修太细，男生的眉毛要有量。",
          "gap": 0.6,
          "card": {
            "type": "copy",
            "text": "别修太细，|要有量",
            "size": 100
          }
        },
        {
          "text": "修完你会发现，不用化妆，脸就干净了。",
          "gap": 1.0,
          "card": {
            "type": "image",
            "src": "textures/bs/bs-brow.jpg",
            "text": "不用化妆，脸就干净了"
          }
        }
      ]
    },
    {
      "ch": 3,
      "label": "体态",
      "scene": "posture",
      "lines": [
        {
          "text": "第三件，体态。",
          "gap": 0.45,
          "card": {
            "type": "section",
            "no": "03",
            "title": "体态",
            "sub": "POSTURE"
          }
        },
        {
          "text": "含胸、驼背、脖子前伸，身高凭空少三厘米，气质掉一半。",
          "gap": 0.6,
          "card": {
            "type": "stat",
            "value": "−3",
            "unit": "CM",
            "label": "含胸驼背偷走的身高",
            "dark": true
