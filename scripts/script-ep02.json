     "el": {
      "kind": "bubble",
      "text": "打游戏",
      "x": 26,
      "y": 46,
      "w": 240,
      "size": 30
     }
    },
    {
     "text": "这不是错。",
     "panel": "p4",
     "el": {
      "kind": "label",
      "text": "不是错，但没入口",
      "x": 30,
      "y": 70,
      "size": 26,
      "color": "#17140f"
     }
