      "type": "slides",
      "frames": [
       "textures/slides/u12b.jpg"
      ],
      "hold": 2.3,
      "transition": "cut"
     }
    }
   ]
  },
  {
   "label": "生活入口",
   "lines": [
    {
     "text": "第二个，你的生活没有入口。",
