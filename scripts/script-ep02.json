    },
    {
     "text": "给不给，是你的事。",
     "card": {
      "type": "copy",
      "text": "给不给，|是你的事",
      "size": 86,
      "dark": true,
      "transition": "cut"
     }
    }
   ]
  },
  {
   "label": "一个月",
   "lines": [
    {
     "text": "那怎么办？一个月，三件事。",
