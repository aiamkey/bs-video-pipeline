     "card": {
      "type": "copy",
      "text": "她要的不是钱",
      "size": 92,
      "transition": "cut"
     }
    },
    {
     "text": "是你能不能带她去一个她没去过的地方。",
     "panel": {
      "id": "p6",
      "bg": "textures/lib/noodle-air.jpg"
