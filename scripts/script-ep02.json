     "el": {
      "kind": "icon",
      "name": "house",
      "x": 34,
      "y": 60,
      "size": 90
     }
    },
    {
     "text": "女生不是要你有趣，是要你有内容。",
     "card": {
      "type": "copy",
      "text": "不是要你有趣，|是要你有内容",
      "size": 72,
      "transition": "cut"
     }
    }
   ]
  },
  {
   "label": "下一步",
   "lines": [
    {
     "text": "第三个，你不敢给下一步。",
