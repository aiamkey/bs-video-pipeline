      "text": "不是冷落 · 在忙",
      "x": 34,
      "y": 50,
      "size": 26,
      "color": "#17140f"
     }
    },
    {
     "text": "第二，每周做一件能说出口的事。",
     "card": {
      "type": "slides",
      "frames": [
       "textures/slides/u7b.jpg"
      ],
      "hold": 2.4,
      "transition": "cut"
