     "panel": {
      "id": "p5",
      "bg": "textures/lib/office-air.jpg"
     },
     "el": {
      "kind": "box",
      "text": "没可期待的",
      "x": 76,
      "y": 24,
      "size": 30
     }
    },
    {
     "text": "你的一天里，没有一件值得讲的事。",
     "panel": "p5",
     "el": {
      "kind": "icon",
      "name": "cross",
      "x": 30,
      "y": 66,
      "size": 74,
      "color": "#c8231b"
